# Obligatoria: clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional: modelo de Claude (por defecto claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Opcional: protege la app con usuario y contraseña (recomendado en Vercel)
APP_USER=admin
APP_PASSWORD=

# Opcional: historial en Supabase. Sin esto, el historial se guarda en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
